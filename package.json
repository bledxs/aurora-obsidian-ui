{
  "name": "aurora-obsidian-ui",
  "version": "0.1.0",
  "description": "Sistema de diseño y componentes base reutilizables e-commerce",
  "type": "module",
  "main": "./dist/aurora-obsidian-ui.umd.cjs",
  "module": "./dist/aurora-obsidian-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aurora-obsidian-ui.js",
      "require": "./dist/aurora-obsidian-ui.umd.cjs"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "lucide-react": "^1.33.0"
  }
}
