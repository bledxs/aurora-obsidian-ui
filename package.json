{
  "name": "aurora-obsidian-ui",
  "version": "0.1.0",
  "description": "High-fidelity, accessible, and modular design system crafted specifically for modern e-commerce applications",
  "type": "module",
  "main": "./dist/aurora-obsidian-ui.umd.cjs",
  "module": "./dist/aurora-obsidian-ui.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aurora-obsidian-ui": "./bin/aurora.js",
    "aurora": "./bin/aurora.js"
  },
  "files": [
    "dist",
    "bin",
    "registry.json",
    "src/components",
    "src/lib",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aurora-obsidian-ui.js",
      "require": "./dist/aurora-obsidian-ui.umd.cjs"
    },
    "./style.css": "./dist/aurora-obsidian-ui.css",
    "./dist/aurora-obsidian-ui.css": "./dist/aurora-obsidian-ui.css",
    "./dist/style.css": "./dist/aurora-obsidian-ui.css",
    "./package.json": "./package.json",
    "./registry.json": "./registry.json"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "tailwind",
    "tailwindcss",
    "ecommerce",
    "e-commerce",
    "accessibility",
    "a11y",
    "wcag",
    "radix",
    "floating-ui",
    "aurora",
    "obsidian",
    "cli"
  ],
  "author": "Aurora Obsidian UI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bledxs/aurora-obsidian-ui.git"
  },
  "bugs": {
    "url": "https://github.com/bledxs/aurora-obsidian-ui/issues"
  },
  "homepage": "https://github.com/bledxs/aurora-obsidian-ui#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run format && npm run lint && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "tailwind-merge": "^3.6.0"
  }
}
